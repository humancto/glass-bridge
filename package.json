{
  "name": "glassbridge-design-baseline",
  "version": "0.1.0",
  "private": true,
  "description": "Fast, verifiable optical file transfer for controlled crossings into air-gapped systems",
  "homepage": "https://humancto.github.io/glass-bridge/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/humancto/glass-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/humancto/glass-bridge/issues"
  },
  "author": "HumanCTO",
  "license": "Apache-2.0",
  "keywords": [
    "air-gap",
    "optical-data-transfer",
    "secure-file-transfer",
    "visible-light-communication",
    "systems-security"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run build:sw && npm run build:research",
    "build:research": "node scripts/build-research-document.mjs",
    "build:sw": "node scripts/build-receiver-service-worker.mjs",
    "generate:browser-fast-fixture": "node scripts/generate-browser-fast-frame-fixture.mjs",
    "benchmark:turbo-qr": "node scripts/benchmark-turbo-qr.mjs",
    "benchmark:turbo-decode": "node scripts/benchmark-turbo-decode.mjs",
    "benchmark:burst-decode": "node scripts/benchmark-burst-decode.mjs",
    "benchmark:capacity": "node scripts/benchmark-capacity-ladder.mjs",
    "benchmark:parallel-decode": "node scripts/benchmark-lane-parallelism.mjs",
    "start": "vite preview",
    "test:unit": "vitest run",
    "test": "npm run build && npm run test:unit && node --test tests/design-baseline.test.mjs"
  },
  "dependencies": {
    "@noble/ed25519": "3.1.0",
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "cborg": "6.1.1",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zxing-wasm": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "type": "module"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humancto.github.io/glass-bridge/spec/glassbridge-device-run-1.schema.json",
  "title": "GlassBridge receiver failed-run diagnostic",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "measured_at",
    "outcome",
    "source_mode",
    "failure_class",
    "reason",
    "profile",
    "progress",
    "camera",
    "device"
  ],
  "properties": {
    "schema": { "const": "glassbridge-device-run/1" },
    "run_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "measured_at": { "type": "string", "format": "date-time" },
    "outcome": { "const": "failed" },
    "source_mode": {
      "enum": ["camera", "saved-frames"],
      "description": "Acquisition source. Only camera records belong in physical screen-to-camera datasets."
    },
    "failure_class": {
      "enum": [
        "camera-error",
        "decode-error",
        "session-mismatch",
        "rank-incomplete",
        "verification-or-policy-error",
        "operator-or-environment-error"
      ]
    },
    "reason": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "lanes"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "visual_phy": { "type": "string" },
        "target_symbol_rate": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "lanes": { "type": "integer", "minimum": 0, "maximum": 16 }
      }
    },
    "transfer_session": { "type": "string" },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "required", "accepted_frames", "duplicate_frames", "rejected_frames"],
      "properties": {
        "rank": { "type": "integer", "minimum": 0 },
        "required": { "type": "integer", "minimum": 0 },
        "accepted_frames": { "type": "integer", "minimum": 0 },
        "duplicate_frames": { "type": "integer", "minimum": 0 },
        "rejected_frames": { "type": "integer", "minimum": 0 }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_seconds",
        "exposures",
        "observed_fps",
        "negotiated_fps",
        "width",
        "height",
        "decode_jobs",
        "successful_decode_jobs",
        "empty_decode_jobs",
        "optical_acquisition_percent",
        "busy_drops",
        "decode_p50_ms",
        "decode_p95_ms",
        "workers"
      ],
      "properties": {
        "active_seconds": { "type": "number", "minimum": 0 },
        "exposures": { "type": "integer", "minimum": 0 },
        "callback_frames": { "type": "integer", "minimum": 0 },
        "camera_exposures": { "type": "integer", "minimum": 0 },
        "duplicate_callbacks": { "type": "integer", "minimum": 0 },
        "submitted_exposures": { "type": "integer", "minimum": 0 },
        "observed_fps": { "type": "number", "minimum": 0 },
        "negotiated_fps": { "type": "number", "minimum": 0 },
        "width": { "type": "integer", "minimum": 0 },
        "height": { "type": "integer", "minimum": 0 },
        "source_width": { "type": "integer", "minimum": 0 },
        "source_height": { "type": "integer", "minimum": 0 },
        "decode_jobs": { "type": "integer", "minimum": 0 },
        "successful_decode_jobs": { "type": "integer", "minimum": 0 },
        "empty_decode_jobs": { "type": "integer", "minimum": 0 },
        "optical_acquisition_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "busy_drops": { "type": "integer", "minimum": 0 },
        "decode_p50_ms": { "type": "number", "minimum": 0 },
        "decode_p95_ms": { "type": "number", "minimum": 0 },
        "workers": { "type": "integer", "minimum": 0 },
        "rate_limited_exposures": { "type": "integer", "minimum": 0 },
        "capture_copy_p50_ms": { "type": "number", "minimum": 0 },
        "capture_copy_p95_ms": { "type": "number", "minimum": 0 },
        "worker_round_trip_p50_ms": { "type": "number", "minimum": 0 },
        "worker_round_trip_p95_ms": { "type": "number", "minimum": 0 },
        "rgba_bytes_per_second": { "type": "number", "minimum": 0 },
        "same_frame_reacquisitions": { "type": "integer", "minimum": 0 },
        "same_frame_reacquisition_successes": { "type": "integer", "minimum": 0 },
        "same_frame_reacquisition_p50_ms": { "type": "number", "minimum": 0 },
        "same_frame_reacquisition_p95_ms": { "type": "number", "minimum": 0 },
        "sampling_ratio": { "type": "number", "minimum": 0 },
        "sampling_status": {
          "enum": ["oversampled", "single-sampled", "undersampled", "unknown"]
        },
        "sampling_warning": { "type": "string" },
        "grid_last_outcome": {
          "enum": [
            "decoded",
            "invalid-image",
            "markers-not-found",
            "geometry-invalid",
            "contrast-low",
            "frame-magic-invalid"
          ]
        },
        "grid_furthest_phy_outcome": {
          "enum": [
            "decoded",
            "invalid-image",
            "markers-not-found",
            "geometry-invalid",
            "contrast-low",
            "frame-magic-invalid"
          ]
        },
        "grid_outcome_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["decoded", "invalid-image", "markers-not-found", "geometry-invalid", "contrast-low", "frame-magic-invalid"],
          "properties": {
            "decoded": { "type": "integer", "minimum": 0 },
            "invalid-image": { "type": "integer", "minimum": 0 },
            "markers-not-found": { "type": "integer", "minimum": 0 },
            "geometry-invalid": { "type": "integer", "minimum": 0 },
            "contrast-low": { "type": "integer", "minimum": 0 },
            "frame-magic-invalid": { "type": "integer", "minimum": 0 }
          }
        },
        "grid_contrast": { "type": "number", "minimum": 0, "maximum": 255 },
        "grid_screen_fill_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "grid_corrected_codewords": { "type": "integer", "minimum": 0 },
        "grid_registration_reuse_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "time_to_first_valid_ms": { "type": "number", "minimum": 0 }
      }
    },
    "device": {
      "type": "string",
      "minLength": 1,
      "description": "Browser user-agent string for local grouping; not a unique physical-device identifier."
    }
  }
}
